PORT=5000
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS can hold multiple comma-separated frontend URLs.
# CORS_ORIGINS=https://your-vercel-app.vercel.app,https://your-custom-domain.com
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/evalsys
JWT_SECRET=your_jwt_secret_here
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PROPOSAL_BUCKET=evalsys-proposals
SUPABASE_STORAGE_LIMIT_MB=1024
DB_CACHE_TTL_MS=15000
DB_CACHE_MAX_ENTRIES=250
